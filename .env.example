# Nexo Connect Lab local defaults and generated-secret placeholders
CONNECT_LAB_SERVICE_NAME=nexo-connect-lab
CONNECT_LAB_ENVIRONMENT=local
CONNECT_LAB_HTTP_PORT=8282
CONNECT_LAB_COMPOSE_PROJECT=nexo-connect-lab
CONNECT_LAB_DATABASE_NAME=nexo_connect_lab
CONNECT_LAB_REDIS_NAMESPACE=nexo-connect-lab
CONNECT_LAB_MEDIA_BUCKET=nexo-connect-lab-media
CONNECT_LAB_IDENTITY_MODE=synthetic
CONNECT_LAB_NEXO_INTEGRATION_ENABLED=false
CONNECT_LAB_CALLS_ENABLED=false
CONNECT_LAB_E2EE_CLAIM=false
CONNECT_LAB_NEXO_DB_DIRECT_ACCESS=false
CONNECT_LAB_DATABASE_LIFECYCLE_ENABLED=true

# Dedicated local infrastructure identities; secrets are generated into .env
CONNECT_LAB_POSTGRES_HOST=postgres
CONNECT_LAB_POSTGRES_PORT=5432
CONNECT_LAB_POSTGRES_USER=nexo_connect_lab
CONNECT_LAB_POSTGRES_PASSWORD=__CONNECT_LAB_POSTGRES_PASSWORD__
CONNECT_LAB_POSTGRES_APP_USER=nexo_connect_lab_app
CONNECT_LAB_POSTGRES_APP_PASSWORD=__CONNECT_LAB_POSTGRES_APP_PASSWORD__
CONNECT_LAB_POSTGRES_APP_MAX_POOL_SIZE=12
CONNECT_LAB_REDIS_HOST=redis
CONNECT_LAB_REDIS_PORT=6379
CONNECT_LAB_REDIS_PASSWORD=__CONNECT_LAB_REDIS_PASSWORD__
CONNECT_LAB_MINIO_ENDPOINT=http://minio:9000
CONNECT_LAB_MINIO_ROOT_USER=nexo-connect-lab-local
CONNECT_LAB_MINIO_ROOT_PASSWORD=__CONNECT_LAB_MINIO_ROOT_PASSWORD__
